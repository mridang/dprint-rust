{
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "echo '${nextRelease.version}' > src/mago/VERSION && echo '${nextRelease.version}' > src/stylua/VERSION && echo '${nextRelease.version}' > src/rumdl/VERSION && echo '${nextRelease.version}' > src/alejandra/VERSION && make build"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "build/*.wasm"
          }
        ]
      }
    ],
    [
      "@semantic-release/git",
      {
        "message": "chore(release): ${nextRelease.version} [skip ci]\\n\\n${nextRelease.notes}",
        "assets": [
          "src/mago/VERSION",
          "src/stylua/VERSION",
          "src/rumdl/VERSION",
          "src/alejandra/VERSION"
        ]
      }
    ]
  ]
}
